{
  "name": "insyndoc",
  "version": "1.0.2",
  "description": "Offline Windows DOCX Editor",
  "author": "InsynDoc",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "dev:web": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/prepare-assets.mjs && node scripts/run-build.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/tauri.mjs build --bundles nsis",
    "preview": "vite preview",
    "test:rust": "node scripts/tauri.mjs --cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@docx-editor.dev/core": "2.34.0",
    "@docx-editor.dev/fonts": "2.34.0",
    "@docx-editor.dev/i18n": "2.34.0",
    "@docx-editor.dev/react": "2.34.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dictionary-en": "^4.0.0",
    "fflate": "^0.8.3",
    "harper.js": "^3.0.0",
    "nspell": "^2.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
